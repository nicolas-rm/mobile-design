        "test:web:extended-fab": "node scripts/check-extended-fab-web.mjs",
        "test:web:fab-menu": "node scripts/check-fab-menu-web.mjs",
        "test:web:page-controls": "node scripts/check-page-controls.mjs",
        "test:web:fab-icon": "node scripts/check-fab-icon-web.mjs",
