        "test:web:visible-states": "node scripts/check-visible-states-web.mjs",
        "test:web:segmented-motion": "node scripts/check-segmented-motion-web.mjs",
        "test:web:typography": "node scripts/check-typography-web.mjs",
        "test:web:action-motion": "node scripts/check-action-motion-web.mjs",
        "test:web:page-typography": "node scripts/check-page-typography.mjs",
        "test:web:appbar-badges": "node scripts/check-appbar-badges-web.mjs",
        "test:web:button-groups": "node scripts/check-button-groups-web.mjs",
        "sync:showcases": "node scripts/sync-showcases.mjs",
        "test:web:remaining": "node scripts/check-remaining-web.mjs && node scripts/check-remaining-touch-web.mjs",
        "test:web:remaining-touch": "node scripts/check-remaining-touch-web.mjs",
        "test:web:choices": "node scripts/check-web-choices.mjs"
    },
    "devDependencies": {
        "playwright-core": "1.64.1"
